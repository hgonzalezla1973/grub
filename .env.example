# Copy this file to .env and fill in your own keys. .env is gitignored — never commit real keys.

# Server-side only (read by server/index.js, never sent to the browser).
# See README-YELP-SETUP.md for how to get one. This is the primary restaurant source.
YELP_API_KEY=

# Client-side (read by Vite, inlined into the JS bundle — see the security note in
# README-GOOGLE-PLACES-SETUP.md). Used as a fallback if Yelp is unavailable.
VITE_GOOGLE_PLACES_API_KEY=
